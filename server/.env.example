PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://imbio:imbio@localhost:5432/actividades_imbio?schema=public"
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
AUTH_USER=imbio
AUTH_PASSWORD=cambia-esto
AUTH_SECRET=cambia-esto-por-una-cadena-larga
# Cloudinary — API Environment variable (Dashboard → Settings → API Keys)
# Sin signos < > y sin https://
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Alternativa (si la URL falla):
# CLOUDINARY_CLOUD_NAME=zzctgvj9
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Matlacho IA — una de las dos (Gemini es gratis):
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
